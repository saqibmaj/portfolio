---
import '@fontsource/inter/300.css';
import '@fontsource/inter/500.css';
import '@fontsource/playfair-display/500.css';
import '../styles/global.css';


interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  publishedTime?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const siteName = 'Saqib Majeed';
const defaultDescription =
  'Projects, ideas, and writing by Saqib Majeed.';

const {
  title = siteName,
  description = defaultDescription,
  ogType = 'website',
  publishedTime,
  ogImage: ogImageProp,
  ogImageWidth,
  ogImageHeight,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const defaultBanner = new URL('/social-card.png', Astro.site).href;
const ogImage = ogImageProp || defaultBanner;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:site_name" content={siteName} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="page-grain" aria-hidden="true"></div>
    <div class="site-wrapper">
      <slot />
    </div>
  </body>
</html>
