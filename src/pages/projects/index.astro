---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ContentSection from '../../components/ContentSection.astro';
import {getContent, getSiteSettings} from '../../lib/sanity';
const [items, settings] = await Promise.all([getContent('project'), getSiteSettings()]);
---
<BaseLayout title="Projects | Saqib Majeed" description="Projects by Saqib Majeed.">
  <SiteHeader title="Projects" tagline={settings.tagline} socialLinks={settings.socialLinks} />
  <main><ContentSection heading="All Projects" id="projects" items={items} /></main>
  <SiteFooter settings={settings} />
</BaseLayout>
