---
import type { TocItem } from '../lib/markdown';

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <>
      <nav class="toc toc--desktop" aria-label="Table of contents" data-toc>
        <p class="toc__heading">Contents</p>
        <ol class="toc__list">
          {items.map((item) => (
            <li class={`toc__item toc__item--h${item.level}`}>
              <a class="toc__link" href={`#${item.id}`} data-toc-link={item.id}>
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="toc-mobile" data-toc-mobile>
        <button
          type="button"
          class="toc-mobile__toggle"
          aria-expanded="false"
          aria-controls="toc-mobile-panel"
          data-toc-toggle
        >
          <span class="sr-only">Table of contents</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>
          </svg>
        </button>
        <nav
          id="toc-mobile-panel"
          class="toc toc--mobile"
          aria-label="Table of contents"
          hidden
          data-toc-panel
        >
          <p class="toc__heading">Contents</p>
          <ol class="toc__list">
            {items.map((item) => (
              <li class={`toc__item toc__item--h${item.level}`}>
                <a class="toc__link" href={`#${item.id}`} data-toc-link={item.id}>
                  {item.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </>
  )
}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const headings = links
    .map((link) => document.getElementById(link.dataset.tocLink || ''))
    .filter((el): el is HTMLElement => Boolean(el));

  function setActive(id: string) {
    for (const link of links) {
      link.classList.toggle('is-active', link.dataset.tocLink === id);
    }
  }

  if (headings.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target?.id) setActive(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] },
    );
    headings.forEach((h) => observer.observe(h));
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-toc-panel]');

  toggle?.addEventListener('click', () => {
    if (!panel || !toggle) return;
    const open = panel.hasAttribute('hidden');
    if (open) panel.removeAttribute('hidden');
    else panel.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      panel?.setAttribute('hidden', '');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
